<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.hd.assistant</string>
  <key>ProgramArguments</key><array><string>__NODE__</string><string>__ROOT__/desktop/server.js</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/state/desktop-assistant.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/state/desktop-assistant-error.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
